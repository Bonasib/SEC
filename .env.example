# ─────────────────────────────────────────────────────────────
# SEC Transmission WMS - environment settings
# Copy to .env (VPS / Docker) or enter in hPanel → Node.js app → Environment variables
# ─────────────────────────────────────────────────────────────

# Required in production
NODE_ENV=production
PORT=3000
# Public address of the system (used in email links)
APP_URL=https://wms.example.com

# First administrator (created only when the database is empty)
ADMIN_EMPLOYEE_NO=admin
# At least 10 characters. If empty, a temporary password is printed once in the logs.
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Where the database, photos and backups are kept (outside the code folder)
DATA_DIR=/var/lib/sec-wms

# Sample data for demos only - keep false in production
SEED_DEMO=false

# Cookies are HTTPS-only in production. Set to false ONLY while testing without SSL.
# COOKIE_SECURE=true

# ── Email (Hostinger email: smtp.hostinger.com, port 465, SSL) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wms@example.com
SMTP_PASS=
MAIL_FROM="Transmission WMS <wms@example.com>"

# Backups (npm run backup)
BACKUP_KEEP=14
