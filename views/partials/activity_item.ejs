<%
  const AI = { create: 'plus', import: 'upload', start: 'play', submit_closure: 'send', approve: 'check', reject: 'x', cancel: 'x-circle', update_execution: 'wrench', upload: 'camera',
    update: 'pen', verify: 'check-circle', request_extension: 'calendar', approve_extension: 'calendar', reject_extension: 'calendar', cancel_extension: 'calendar',
    schedule_handover: 'clock', cancel_handover: 'clock', handover: 'transfer', attendance: 'users' };
  const tone = ['approve', 'approve_extension', 'handover', 'verify'].includes(a.action) ? 'ok' : ['reject', 'cancel', 'reject_extension'].includes(a.action) ? 'bad' : ['request_extension', 'schedule_handover', 'submit_closure'].includes(a.action) ? 'warn' : '';
  let after = {}; try { after = JSON.parse(a.after_json || '{}'); } catch (e) {}
  const detail = [after.status ? t('st_' + after.status) : null, after.planned_end ? arrow + ' ' + fmt(after.planned_end) : null, after.stage ? t(after.stage) : null, after.to ? arrow + ' ' + after.to : null, after.material_number || null, after.reservation_number || null].filter(Boolean).join(' · ');
%>
<li class="act act-<%= tone %>">
  <span class="act-ic"><%- ic(AI[a.action] || 'pen') %></span>
  <div class="act-body">
    <div><b><%= t('act_' + a.action) === 'act_' + a.action ? lbl('action', a.action) : t('act_' + a.action) %></b><% if (showWo) { %> · <a class="wo-link" href="/wo/<%= a.wo_id %>"><%= a.wo_number %></a> <span class="muted small"><%= a.title %></span><% } %></div>
    <% if (detail || a.reason) { %><div class="small"><%= detail %><%= detail && a.reason ? ' · ' : '' %><% if (a.reason) { %><span class="muted"><%- ic('message') %> <%= isDemo ? tx(a.reason).replace(/\s*\((?:تجريبي|عينة|demo|sample)\)/gi, '') : tx(a.reason) %></span><% } %></div><% } %>
    <div class="muted small"><%= a.employee_no ? nm(a) : t('system') %> · <%= fmt(a.at) %></div>
  </div>
</li>
