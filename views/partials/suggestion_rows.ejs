<% if (list.length) { %>
<% if (title) { %><h3 style="padding:0 20px;margin-top:8px;display:flex;gap:8px;align-items:center"><span class="pill <%= tone %>"><%= list.length %></span><%= title %></h3><% } %>
<div class="table-wrap"><table class="tbl">
  <thead><tr><th><%= t('employee') %></th><th><%= t('section') %></th><th><%= t('reason') %></th><th><%= t('suggested_courses') %></th></tr></thead>
  <tbody>
  <% list.forEach(s => { %>
    <tr>
      <td><a <%- empHref(s.id) %> style="display:flex;align-items:center;gap:10px;color:inherit"><span class="avatar" style="width:30px;height:30px;font-size:12px"><%- face(s) %></span><span><span class="cell-main"><%= nm(s) %></span><span class="cell-sub mono"><%= s.employee_no %></span></span></a></td>
      <td class="mono"><%= s.section_code %></td>
      <td><% s.reasons.forEach(r => { %><span class="pill <%= r === 'plan' || r === 'below' ? 'bad' : r.startsWith('rating') ? 'warn' : '' %>" style="margin:2px"><%= t('why_' + r) %></span><% }) %><% if (s.plan_id) { %><a class="small" href="/plans/<%= s.plan_id %>" style="display:block"><%= t('plan') %> →</a><% } %></td>
      <td><div class="sug-courses">
        <% s.courses.forEach(c => { %><div class="sug-course">
          <span class="grow"><a href="/training/<%= c.id %>"><%= lang === 'en' ? c.title_en : c.title_ar %></a><span class="cell-sub mono"><%= c.start_date %> · <%= c.mode === 'remote' ? t('mode_remote') : (c.city || c.country || '') %></span></span>
          <% if (canManage) { %><form method="post" action="/training/<%= c.id %>/register" style="margin:0"><input type="hidden" name="employee_ids" value="<%= s.id %>"><input type="hidden" name="back" value="list"><button class="btn small"><%- ic('plus') %><%= t('register') %></button></form><% } %>
        </div><% }) %></div></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% } %>
