<%# Inventory picker for a work order: every active item with its picture, inventory number and quantities.
    Enter a quantity next to the items you need; empty rows are ignored. Params: items, sel { ids, qtys } %>
<% const chosen = {}; [].concat(sel && sel.ids || []).forEach((id, n) => { const q = [].concat(sel.qtys || [])[n]; if (Number(q) > 0) chosen[id] = q; }); %>
<div class="item-grid" data-item-grid>
  <div class="ig-tools">
    <label class="search-field"><%- ic('search') %><input type="search" data-ig-search placeholder="<%= t('search_items') %>" aria-label="<%= t('search_items') %>"></label>
    <div class="segmented" role="group" aria-label="<%= t('item_kind') %>">
      <button type="button" class="seg on" data-ig-kind=""><%= t('all') %></button>
      <% ['material','tool','equipment'].forEach(k => { %><button type="button" class="seg" data-ig-kind="<%= k %>"><%= t('ik_' + k + '_pl') %></button><% }) %>
    </div>
    <label class="inline small"><input type="checkbox" data-ig-only><%= t('selected_only') %></label>
    <span class="pill info" data-ig-count aria-live="polite">0</span>
  </div>
  <div class="ig-list" role="list">
    <% if (!items.length) { %><p class="muted" style="padding:12px"><%= t('no_items_yet') %> <a href="/materials"><%= t('materials_tools') %> →</a></p><% } %>
    <% items.forEach(i => { const off = i.available <= 0 && !chosen[i.id]; %>
    <div class="ig-row <%= off ? 'off' : '' %> <%= chosen[i.id] ? 'picked' : '' %>" role="listitem" data-kind="<%= i.kind %>" data-text="<%= [i.code, i.inventory_no, i.name_ar, i.name_en, i.category].filter(Boolean).join(' ').toLowerCase() %>">
      <%- thumb(i) %>
      <div class="ig-main">
        <b><%= lang === 'en' && i.name_en ? i.name_en : i.name_ar %></b>
        <span class="cell-sub"><span class="mono"><%= i.code %></span><%= i.inventory_no ? ' · # ' + i.inventory_no : '' %> · <span class="pill ik-<%= i.kind %>" style="padding:0 6px"><%= t('ik_' + i.kind) %></span></span>
      </div>
      <div class="ig-stats">
        <span title="<%= t('available') %>"><small><%= t('available') %></small><b class="<%= i.out ? 'bad' : i.low ? 'warn-text' : '' %>"><%= i.available %></b></span>
        <span title="<%= t('reserved') %>"><small><%= t('reserved') %></small><b><%= i.reserved %></b></span>
        <span title="<%= t('on_order') %>"><small><%= t('on_order') %></small><b><%= i.on_order %></b></span>
      </div>
      <div class="ig-qty">
        <input type="hidden" name="item_ids" value="<%= i.id %>">
        <input type="number" name="item_qtys" min="0" step="any" max="<%= Math.max(0, i.available) %>" value="<%= chosen[i.id] || '' %>" placeholder="0" <%= off ? 'disabled' : '' %> aria-label="<%= t('quantity') %> <%= i.code %>">
        <small class="muted"><%= t('uom_' + i.uom) %></small>
      </div>
    </div>
    <% }) %>
  </div>
</div>
