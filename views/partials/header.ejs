<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>" data-theme="<%= theme %>">
<head>
<%- include('head') %>
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · ' : '' %><%= t('app_short') %></title>
</head>
<body>
<%- include('icons') %>
<a class="skip-link" href="#main"><%= t('skip_to_content') %></a>
<% const r = user.role; const mgr = ['team_leader','section_head','division_manager','department_manager','sector_head'];
   const canCreate = [...mgr, 'admin'].includes(r);
   const isActive = (href) => path === href || (href !== '/' && path.startsWith(href + '/') && path !== '/wo/new');
   const L = (href, key, icon, show = true, badge = 0) => show ? `<a href="${href}" class="nav-link${isActive(href) ? ' active' : ''}"${isActive(href) ? ' aria-current="page"' : ''}>${ic(icon)}<span>${t(key)}</span>${badge ? `<span class="nav-badge">${badge}</span>` : ''}</a>` : ''; %>
<div class="app">
  <aside class="sidebar" id="sidebar" aria-label="<%= t('menu') %>">
    <a class="brand" href="/">
      <span class="brand-mark"><%- ic('zap') %></span>
      <span class="brand-text"><b><%= t('app_short') %></b><small>SEC · Transmission WMS</small></span>
    </a>
    <nav class="nav">
      <div class="nav-group"><span class="nav-label"><%= t('grp_operations') %></span>
        <%- L('/', 'dashboard', 'dashboard') %>
        <%- L('/wo', 'work_orders', 'clipboard') %>
        <%- L('/wo/new', 'new_wo', 'plus', canCreate) %>
        <%- L('/tasks', 'daily_tasks', 'tasks') %>
        <%- L('/activity', 'activity', 'clock', !!hasPerm('wo.view_history')) %>
        <%- L('/travel', 'travel_assignments', 'route') %>
        <%- L('/calendar', 'calendar', 'calendar') %>
        <%- L('/notifications', 'notifications', 'bell', true, unread) %>
      </div>
      <div class="nav-group"><span class="nav-label"><%= t('grp_people') %></span>
        <%- L('/employees', 'employees', 'users', r !== 'employee' && r !== 'warehouse') %>
        <%- L('/leaves', 'leaves', 'user-check', r !== 'employee' && r !== 'warehouse') %>
        <%- L('/training', 'training', 'file') %>
        <%- L('/plans', 'plans', 'route') %>
        <%- L('/points', 'points', 'star') %>
        <%- L('/acting', 'acting', 'pen') %>
        <%- L('/org', 'org_units', 'network') %>
      </div>
      <div class="nav-group"><span class="nav-label"><%= t('grp_assets') %></span>
        <%- L('/assets', 'assets', 'tower') %>
        <%- L('/fleet', 'fleet', 'truck') %>
        <%- L('/equipment', 'devices', 'wrench') %>
        <%- L('/materials', 'materials_tools', 'boxes') %>
      </div>
      <div class="nav-group"><span class="nav-label"><%= t('grp_admin') %></span>
        <%- L('/permissions', 'permissions', 'shield', ['hr','admin','auditor'].includes(r)) %>
        <%- L('/data', 'data', 'transfer') %>
        <%- L('/outbox', 'outbox', 'mail', ['admin','auditor'].includes(r)) %>
        <%- L('/audit', 'audit', 'file', ['admin','auditor'].includes(r)) %>
        <%- L('/settings', 'settings', 'settings', r === 'admin') %>
      </div>
    </nav>
    <div class="sidebar-foot"><% if (isDemo) { %><span class="env-pill" title="<%= t('sample_banner') %>"><span class="dot"></span><%= t('sample_short') %></span><% } %></div>
  </aside>
  <div class="scrim" data-close-nav></div>
  <div class="main-col">
    <header class="topbar">
      <button class="icon-btn menu-btn" type="button" aria-label="<%= t('menu') %>" aria-controls="sidebar" aria-expanded="false" data-toggle-nav><%- ic('menu') %></button>
      <div class="topbar-spacer"></div>
      <% if (canCreate && path !== '/wo/new') { %><a class="btn primary btn-sm hide-sm" href="/wo/new"><%- ic('plus') %><%= t('new_wo') %></a><% } %>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="<%= t('theme_dark') %> / <%= t('theme_light') %>" title="<%= t('theme_dark') %> / <%= t('theme_light') %>"><%- ic('moon', 'only-light') %><%- ic('sun', 'only-dark') %></button>
      <a class="icon-btn lang-btn" href="/lang/<%= lang === 'ar' ? 'en' : 'ar' %>" title="<%= t('language') %>" lang="<%= lang === 'ar' ? 'en' : 'ar' %>"><%- ic('globe') %><span><%= lang === 'ar' ? 'EN' : 'ع' %></span></a>
      <a class="icon-btn bell" href="/notifications" aria-label="<%= t('notifications') %>"><%- ic('bell') %><span id="unread" class="count <%= unread ? '' : 'hidden' %>" aria-live="polite"><%= unread %></span></a>
      <a class="user-chip" href="/employees/<%= user.id %>">
        <span class="avatar" aria-hidden="true"><%= initials(user) %></span>
        <span class="user-meta"><b><%= nm(user) %></b><small><%= t('role_' + user.role) %></small></span>
      </a>
      <form method="post" action="/logout"><button class="icon-btn" aria-label="<%= t('logout') %>" title="<%= t('logout') %>"><%- ic('logout', 'flip-rtl') %></button></form>
    </header>
    <main class="content" id="main" tabindex="-1">
<% if (flash) { %><div class="flash flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%- ic(flash.type === 'error' ? 'x-circle' : flash.type === 'warning' ? 'alert' : 'check-circle') %><div><%= flash.msg %></div></div><% } %>
