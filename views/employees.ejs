<%- include('partials/header', { pageTitle: t('employees') }) %>
<div class="page-head"><div><div class="eyebrow"><%- ic('users') %><%= t('grp_people') %></div><h1><%= t('employees') %> <span class="result-count">(<%= rows.length %>)</span></h1></div>
  <div class="btns"><% if (canManage) { %><a class="btn primary" href="/employees/new"><%- ic('plus') %><%= t('add_employee') %></a><% } %><a class="btn" href="/data/export/employees"><%- ic('sheet') %>Excel</a><a class="btn" href="/data/export/employees?format=csv"><%- ic('download') %>CSV</a><a class="btn" href="/data#employees"><%- ic('upload') %><%= t('import') %></a></div></div>
<form class="filters card" method="get" role="search">
  <div class="search-field"><%- ic('search') %><input name="q" value="<%= query.q || '' %>" placeholder="<%= t('search') %>" aria-label="<%= t('search') %>"></div>
  <select name="section"><option value=""><%= t('section') %>: <%= t('all') %></option><% sections.forEach(s => { %><option value="<%= s.id %>" <%= String(query.section) === String(s.id) ? 'selected' : '' %>><%= s.code %> <%= nm(s) %></option><% }) %></select>
  <select name="role"><option value=""><%= t('role') %>: <%= t('all') %></option><% ROLES.forEach(r => { %><option value="<%= r %>" <%= query.role === r ? 'selected' : '' %>><%= t('role_' + r) %></option><% }) %></select>
  <select name="status" aria-label="<%= t('status') %>"><option value=""><%= t('status') %>: <%= t('all') %></option><% ['active','inactive','transferred','retired'].forEach(x => { %><option value="<%= x %>" <%= query.status === x ? 'selected' : '' %>><%= lbl('emp_status', x) %></option><% }) %></select>
  <select name="availability" aria-label="<%= t('availability') %>"><option value=""><%= t('availability') %>: <%= t('all') %></option><option value="available" <%= query.availability === 'available' ? 'selected' : '' %>><%= t('emp_available') %></option><option value="away" <%= query.availability === 'away' ? 'selected' : '' %>><%= t('away_today') %></option><option value="busy" <%= query.availability === 'busy' ? 'selected' : '' %>><%= t('st_in_progress') %></option></select>
  <% if (canManage) { %><select name="docs" aria-label="<%= t('documents') %>"><option value=""><%= t('documents') %>: <%= t('all') %></option><option value="expiring" <%= query.docs === 'expiring' ? 'selected' : '' %>><%= t('docs_expiring') %></option></select><% } %>
  <% if (nationalities.length) { %><select name="nationality" aria-label="<%= t('nationality') %>"><option value=""><%= t('nationality') %>: <%= t('all') %></option><% nationalities.forEach(n => { %><option <%= query.nationality === n ? 'selected' : '' %>><%= n %></option><% }) %></select><% } %>
  <select name="sort" aria-label="<%= t('sort_by') %>"><% [['no','employee_no'],['name','name'],['section','section'],['role','role'],['title','job_title'],['hired','hire_date']].forEach(([k, l]) => { %><option value="<%= k %>" <%= (query.sort || 'no') === k ? 'selected' : '' %>><%= t('sort_by') %>: <%= t(l) %></option><% }) %></select>
  <select name="dir" aria-label="<%= t('sort_dir') %>"><option value="asc"><%= t('ascending') %></option><option value="desc" <%= query.dir === 'desc' ? 'selected' : '' %>><%= t('descending') %></option></select>
  <button class="btn primary"><%- ic('filter') %><%= t('filter') %></button><a class="btn ghost" href="/employees"><%= t('clear') %></a>
</form>
<div class="card table-card"><div class="table-wrap"><table class="tbl">
  <thead><tr><th><%= t('employee_no') %></th><th><%= t('name') %></th><th><%= t('job_title') %></th><th><%= t('section') %></th><th><%= t('nationality') %></th><th><%= t('role') %></th><th><%= t('email') %></th><th><%= t('points') %></th><th><%= t('status') %></th></tr></thead><tbody>
  <% if (!rows.length) { %><tr><td colspan="9" class="empty"><%= t('no_records') %></td></tr><% } %>
  <% rows.forEach(e => { %><tr>
    <td><a class="wo-link" <%- empHref(e.id) %>><%= e.employee_no %></a></td><td><span style="display:flex;align-items:center;gap:10px"><span class="avatar av-sm"><%- face(e) %></span><span class="cell-main"><%= nm(e) %></span><% if (docFlags[e.id]) { %><a class="pill <%= docFlags[e.id] === 'expired' ? 'bad' : 'warn' %>" href="/employees/<%= e.id %>#documents" title="<%= t('doc_' + docFlags[e.id]) %>"><%- ic('file') %></a><% } %></span></td><td><%= lang === 'ar' && e.job_title_ar ? e.job_title_ar : e.job_title_en || '' %></td><td><%= e.section_code || '' %></td><td><%= e.nationality || '' %></td>
    <td><%= t('role_' + e.role) %></td><td class="small" dir="ltr"><%= e.email || '—' %></td><td><% const p = pts[e.id]; if (p && p.rating) { %><span class="rt rt-<%= p.rating %>"><%= t('rt_' + p.rating) %></span><% } else if (p && p.below) { %><span class="pill bad">↓</span><% } else { %><span class="muted small">—</span><% } %></td>
    <td><% if (e.status !== 'active') { %><span class="pill bad"><%= lbl('emp_status', e.status) %></span><% } else if (e.leave_today) { %><span class="pill warn"><%= lbl('leave_type', e.leave_today) %></span><% } else if (e.busy) { %><span class="pill"><%= t('st_in_progress') %></span><% } else { %><span class="pill ok"><%- ic('check') %><%= t('emp_available') %></span><% } %></td>
  </tr><% }) %>
</tbody></table></div></div>

<%- include('partials/footer') %>
