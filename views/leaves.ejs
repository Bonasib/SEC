<%- include('partials/header', { pageTitle: t('leaves') }) %>
<div class="page-head"><div><div class="eyebrow"><%- ic('calendar') %><%= t('grp_people') %></div><h1><%= t('leaves') %></h1></div><div class="btns"><a class="btn" href="/data/export/leaves"><%- ic('sheet') %>Excel</a><a class="btn" href="/data#leaves"><%- ic('upload') %><%= t('import') %></a><a class="btn" href="/calendar"><%- ic('calendar') %><%= t('calendar') %></a><a class="btn ghost" href="?current=1"><%= lang === 'ar' ? 'الحالية والقادمة' : 'Current & upcoming' %></a></div></div>
<% if (['hr','admin'].includes(user.role)) { %>
<form method="post" action="/leaves" class="card form-grid">
  <label><%= t('employee') %> *<select name="employee_id" required><option value=""></option><% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.employee_no %> - <%= nm(e) %></option><% }) %></select></label>
  <label><%= t('type') %><select name="type" id="leave-type"><% LEAVE_TYPES.forEach(x => { %><option value="<%= x %>"><%= t('lt_' + x) %></option><% }) %></select></label>
  <div id="mode-wrap" class="span2 hidden"><p class="mb-2"><b><%= t('mode') %></b> <span class="req">*</span></p>
    <div class="segmented" role="radiogroup"><% MODES.forEach(m => { %><label><input type="radio" name="mode" value="<%= m %>"><%= t('mode_' + m) %></label><% }) %></div></div>
  <label><%= t('location') %><input name="location" placeholder="<%= lang === 'ar' ? 'المصنع / المدينة / الدولة' : 'Factory / city / country' %>"></label>
  <label><%= t('from') %> *<input type="date" name="start_date" required></label>
  <label><%= t('to') %> *<input type="date" name="end_date" required></label>
  <label class="span2"><%= t('notes') %><input name="notes"></label>
  <div class="span2"><button class="btn primary"><%- ic('plus') %><%= t('add') %></button> <small class="muted"><%= lang === 'ar' ? 'يُمنع إسناد مهام للموظف خلال هذه الفترة، ويُنبَّه قائد الفريق إن كانت لديه مهام قائمة.' : 'The employee cannot be assigned during this period; team leaders of existing work are alerted.' %></small></div>
</form>
<% } %>
<div class="card table-card"><div class="table-wrap"><table class="tbl">
  <thead><tr><th><%= t('employee') %></th><th><%= t('type') %></th><th><%= t('mode') %> / <%= t('location') %></th><th><%= t('from') %></th><th><%= t('to') %></th><th><%= t('status') %></th><th><%= t('notes') %></th><th></th></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="8" class="empty"><%= t('no_records') %></td></tr><% } %>
  <% const hrEdit = ['hr','admin'].includes(user.role);
     rows.forEach(l => { %><tr class="<%= l.status === 'cancelled' ? 'muted' : '' %>"><td><a <%- empHref(l.employee_id) %>><%= l.employee_no %></a> <%= nm(l) %></td><td><span class="ev-tag ev-<%= l.type %>"><%= t('lt_' + l.type) %></span></td><td><%= l.mode ? t('mode_' + l.mode) : '' %><%= l.location ? (l.mode ? ' · ' : '') + l.location : '' %></td><td class="mono"><%= l.start_date %></td><td class="mono"><%= l.end_date %></td><td><span class="pill <%= l.status === 'approved' ? 'ok' : l.status === 'cancelled' ? 'bad' : 'warn' %>"><%= lbl('leave_status', l.status) %></span></td><td><%= l.notes || '' %></td>
    <td class="nowrap"><% if (hrEdit && l.status !== 'cancelled') { %>
      <details><summary class="btn small ghost"><%- ic('pen') %><%= t('edit') %></summary>
        <form method="post" action="/leaves/<%= l.id %>" class="mini-grid">
          <label><%= t('type') %><select name="type"><% LEAVE_TYPES.forEach(x => { %><option value="<%= x %>" <%= l.type === x ? 'selected' : '' %>><%= t('lt_' + x) %></option><% }) %></select></label>
          <label><%= t('mode') %><select name="mode"><option value=""></option><% MODES.forEach(m => { %><option value="<%= m %>" <%= l.mode === m ? 'selected' : '' %>><%= t('mode_' + m) %></option><% }) %></select></label>
          <label><%= t('from') %><input type="date" name="start_date" value="<%= l.start_date %>" required></label>
          <label><%= t('to') %><input type="date" name="end_date" value="<%= l.end_date %>" required></label>
          <label><%= t('location') %><input name="location" value="<%= l.location || '' %>"></label>
          <label><%= t('status') %><select name="status"><% ['approved','pending'].forEach(x => { %><option value="<%= x %>" <%= l.status === x ? 'selected' : '' %>><%= lbl('leave_status', x) %></option><% }) %></select></label>
          <label><%= t('notes') %><input name="notes" value="<%= l.notes || '' %>"></label>
          <button class="btn small primary"><%- ic('save') %><%= t('save') %></button>
        </form>
        <form method="post" action="/leaves/<%= l.id %>/cancel" data-confirm="<%= t('cancel') %>?"><button class="btn small ghost danger"><%- ic('x') %><%= t('cancel') %></button></form>
      </details><% } %></td></tr><% }) %>
  </tbody>
</table></div></div>
<%- include('partials/footer') %>
